# Este archivo es de ejemplo de como sera el .env
# Nunca suban este archivo a github

# Puerto donde correra la API
PORT=4000

# Cadena de conexión de mongodb atlas (atlas > connect > drivers)
# Se remplaza los <> con los datos
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/cibercafe_nova?retryWrites=true&w=majority

# Origen permitido del frontend. En desarrollo, vite usa 5173
CORS_ORIGIN=http://localhost:5173

# Clave secreta con la que se firman los tokens de sesión.
# Debe ser un texto largo y aleatorio, distinto en cada entorno. Nunca se comparte.
JWT_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio

# Cuánto dura la sesión antes de pedir login otra vez, sera definida en 8 hrs
JWT_EXPIRES_IN=8h

# Cuentas iniciales que crea "npm run seed:usuarios" (contraseña de al menos 8 caracteres).
# Cámbialas por tus propios datos en tu archivo .env.
ADMIN_NOMBRE=Nombre del administrador
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia_esta_contraseña

OPERADOR_NOMBRE=Nombre del operador
OPERADOR_EMAIL=operador@ejemplo.com
OPERADOR_PASSWORD=cambia_esta_contraseña

CLIENTE_NOMBRE=Nombre del cliente de prueba
CLIENTE_EMAIL=cliente@ejemplo.com
CLIENTE_PASSWORD=cambia_esta_contraseña