# Este archivo es de ejemplo de como sera el .env
# Nunca suban este archivo a github

# Puerto donde correra la API
PORT=4000

# Cadena de conexión de mongodb atlas (atlas > connect > drivers)
# Se remplaza los <> con los datos
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/cibercafe_nova?retryWrites=true&w=majority

# Origen permitido del frontend. En desarrollo, vite usa 5173
CORS_ORIGIN=http://localhost:5173
